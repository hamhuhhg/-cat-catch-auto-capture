{
  "background": {
    "scripts": [
      "js/background.js"
    ]
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "__MSG_catCatch__",
    "default_popup": "popup.html"
  },
  "description": "__MSG_description__",
  "icons": {
    "64": "img/icon.png",
    "128": "img/icon128.png"
  },
  "manifest_version": 3,
  "name": "__MSG_catCatch__",
  "homepage_url": "https://github.com/xifangczy/cat-catch",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "webNavigation",
    "alarms",
    "scripting",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "catch-script/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "default_locale": "en",
  "version": "2.6.3"
}
